Table cliente [headercolor: #20479e] {
  id integer [pk, not null]
  nombre varchar(100) [not null]
}

Table pedido {
  id integer [pk, not null]
  cliente_id integer [not null, ref: > cliente.id]
  vendedor_id integer
  fecha date [not null]
  Note: 'FK pendiente: vendedor_id -> vendedor.id'
}
